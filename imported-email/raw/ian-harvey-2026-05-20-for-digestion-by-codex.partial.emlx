&quot;Yu Gothic&quot;, Meiryo, &quot;PingFang SC&quot;, &quot;Microsoft =
YaHei&quot;, &quot;PingFang TC&quot;, &quot;Microsoft JhengHei&quot;, =
&quot;PingFang HK&quot;, &quot;Microsoft JhengHei&quot;, &quot;PingFang =
MO&quot;, &quot;Microsoft JhengHei&quot;, &quot;Apple SD Gothic =
Neo&quot;, &quot;Malgun Gothic&quot;, sans-serif, &quot;Apple Color =
